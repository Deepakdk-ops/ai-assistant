ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME@localhost:5433/ai_assistant
CORS_ORIGINS=http://localhost:8080
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_MINUTES=30
ALLOW_SIGNUP=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
POSTGRES_DB=ai_assistant
POSTGRES_USER=app_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_DATABASE_PASSWORD

REDIS_PASSWORD=replace-with-a-strong-random-password
REDIS_URL=redis://:replace-with-a-strong-random-password@localhost:6379/0
CELERY_BROKER_URL=redis://:replace-with-a-strong-random-password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-a-strong-random-password@localhost:6379/2

REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
